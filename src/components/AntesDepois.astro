---
import { Image } from "astro:assets";
import antes1 from "../assets/media/antes-depois-1-antes.jpg";
import depois1 from "../assets/media/antes-depois-1-depois.jpg";
import antes2 from "../assets/media/antes-depois-2-antes.jpg";
import depois2 from "../assets/media/antes-depois-2-depois.jpg";
import antes3 from "../assets/media/antes-depois-3-antes.jpg";
import depois3 from "../assets/media/antes-depois-3-depois.jpg";

// As 3 duplas vêm de 3 posts reais distintos do Instagram (nunca o antes de
// uma cliente combinado com o depois de outra). Cada par é identificado pelo
// mesmo shortcode de post nos dois arquivos, confirmando que antes e depois
// são genuinamente da mesma cliente — ver Bases/processo-criativo-refinamento.md.
const duplas = [
  { antes: antes1, depois: depois1, alt: "cabelo real da cliente 1" },
  { antes: antes2, depois: depois2, alt: "cabelo real da cliente 2" },
  { antes: antes3, depois: depois3, alt: "cabelo real da cliente 3" },
];
---

<section id="antes-depois" class="scroll-mt-20 bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-4xl px-5 sm:px-8">
    <div class="reveal max-w-2xl">
      <h2 class="font-display text-3xl font-medium text-ink sm:text-4xl">
        Antes & depois: resultados reais, sem edição de fantasia
      </h2>
      <p class="mt-4 text-base leading-relaxed text-ink-soft sm:text-lg">
        Fotos reais de clientes atendidas pela Renata — o trabalho fala por
        si.
      </p>
    </div>

    {/* Mobile (<sm): um card por cliente, antes/depois lado a lado, empilhados verticalmente
        para que cada foto fique legível (evita miniaturas de ~97x121px). */}
    <div class="reveal mt-12 flex flex-col gap-8 sm:hidden">
      {
        duplas.map((dupla) => (
          <div class="grid grid-cols-2 gap-3">
            <div>
              <p class="mb-2 text-center text-xs font-semibold tracking-widest text-ink-soft uppercase">
                Antes
              </p>
              <div class="overflow-hidden rounded-sm border border-ink/10 shadow-sm">
                <Image
                  src={dupla.antes}
                  alt={`Antes: ${dupla.alt}, sem extensão`}
                  class="aspect-[4/5] w-full object-cover"
                  widths={[280, 360, 480]}
                  sizes="45vw"
                  loading="lazy"
                />
              </div>
            </div>
            <div>
              <p class="mb-2 text-center text-xs font-semibold tracking-widest text-accent uppercase">
                Depois
              </p>
              <div class="overflow-hidden rounded-sm border border-ink/10 shadow-sm">
                <Image
                  src={dupla.depois}
                  alt={`Depois: ${dupla.alt}, com extensão aplicada pela Renata`}
                  class="aspect-[4/5] w-full object-cover"
                  widths={[280, 360, 480]}
                  sizes="45vw"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>

    {/* sm e acima: layout original em duas fileiras de 3 colunas. */}
    <div class="reveal mt-12 hidden sm:block">
      <p class="text-center text-xs font-semibold tracking-widest text-ink-soft uppercase">Antes</p>
      <div class="mt-3 grid grid-cols-3 gap-3 sm:gap-4">
        {
          duplas.map((dupla) => (
            <div class="overflow-hidden rounded-sm border border-ink/10 shadow-sm">
              <Image
                src={dupla.antes}
                alt={`Antes: ${dupla.alt}, sem extensão`}
                class="aspect-[4/5] w-full object-cover"
                widths={[180, 280, 360]}
                sizes="(min-width: 640px) 220px, 30vw"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </div>

    <div class="reveal mt-6 hidden sm:block">
      <p class="text-center text-xs font-semibold tracking-widest text-accent uppercase">Depois</p>
      <div class="mt-3 grid grid-cols-3 gap-3 sm:gap-4">
        {
          duplas.map((dupla) => (
            <div class="overflow-hidden rounded-sm border border-ink/10 shadow-sm">
              <Image
                src={dupla.depois}
                alt={`Depois: ${dupla.alt}, com extensão aplicada pela Renata`}
                class="aspect-[4/5] w-full object-cover"
                widths={[180, 280, 360]}
                sizes="(min-width: 640px) 220px, 30vw"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
