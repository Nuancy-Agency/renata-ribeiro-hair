---
import { whatsappLink } from "../data/whatsapp";

const navLinks = [
  { href: "#sobre", label: "Sobre" },
  { href: "#servicos", label: "Especialidades" },
  { href: "#antes-depois", label: "Antes & Depois" },
  { href: "#depoimentos", label: "Depoimentos" },
  { href: "#localizacao", label: "Localização" },
];

const ctaHref = whatsappLink(
  "Olá, Renata! Vi o site e gostaria de agendar um horário.",
);
---

<header
  x-data="{ open: false }"
  class="sticky top-0 z-50 border-b border-ink/10 bg-paper/90 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
    <a
      href="#topo"
      class="font-display text-xl tracking-wide text-ink sm:text-2xl"
      translate="no"
    >
      Renata&nbsp;Ribeiro <span class="text-accent">Hair</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegação principal">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-ink-soft transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition-colors hover:bg-accent"
      >
        Agendar no WhatsApp
      </a>
    </nav>

    <button
      type="button"
      x-ref="menuButton"
      data-js-toggle
      class="flex h-11 w-11 items-center justify-center rounded-full text-ink md:hidden"
      style="touch-action: manipulation;"
      @click="open = !open"
      :aria-expanded="open"
      aria-controls="menu-mobile"
      :aria-label="open ? 'Fechar menu de navegação' : 'Abrir menu de navegação'"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6" x-show="!open" />
        <line x1="3" y1="12" x2="21" y2="12" x-show="!open" />
        <line x1="3" y1="18" x2="21" y2="18" x-show="!open" />
        <line x1="5" y1="5" x2="19" y2="19" x-show="open" x-cloak />
        <line x1="19" y1="5" x2="5" y2="19" x-show="open" x-cloak />
      </svg>
    </button>
  </div>

  <nav
    id="menu-mobile"
    x-show="open"
    x-cloak
    x-transition
    @keydown.escape.window="open = false; $refs.menuButton.focus()"
    @click.outside="open = false"
    class="border-t border-ink/10 bg-paper px-5 pb-6 md:hidden"
    aria-label="Navegação mobile"
  >
    <ul class="flex flex-col gap-1 pt-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              @click="open = false"
              class="block rounded px-2 py-3 text-base font-medium text-ink-soft hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href={ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-full bg-ink px-5 py-3 text-center text-sm font-semibold text-paper"
        >
          Agendar no WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>
