---
import { Image } from "astro:assets";
import heroImage from "../assets/media/hero-cabelo.jpg";
import { whatsappLink } from "../data/whatsapp";

const ctaHref = whatsappLink(
  "Olá, Renata! Vi o site e quero agendar uma avaliação.",
);
---

<section id="topo" class="relative isolate overflow-hidden bg-ink">
  <Image
    src={heroImage}
    alt="Still de cabelo com mechas iluminadas, resultado real de trabalho da Renata Ribeiro Hair"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    widths={[480, 828, 1200, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/40 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto flex min-h-[88svh] max-w-6xl flex-col justify-end px-5 pb-16 pt-32 sm:px-8 sm:pb-24"
  >
    <h1
      class="reveal max-w-2xl font-display text-4xl font-medium leading-[1.05] text-paper sm:text-6xl"
    >
      O seu cabelo merece a técnica certa para <span class="italic text-blush">devolver a sua autoestima.</span>
    </h1>
    <p
      class="reveal mt-6 max-w-xl text-base text-paper/85 sm:text-lg"
      style="transition-delay: 160ms;"
    >
      Especialista em extensão de cabelo (mega hair, técnica fita adesiva),
      coloração e alisamento em Benfica, Lisboa — 14 anos de experiência
      dedicados a valorizar a sua beleza e a sua personalidade.
    </p>
    <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row" style="transition-delay: 240ms;">
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-accent px-7 py-3.5 text-base font-semibold text-paper transition-colors hover:bg-accent-deep"
      >
        Agendar horário no WhatsApp
      </a>
      <a
        href="#antes-depois"
        class="inline-flex items-center justify-center rounded-full border border-paper/40 px-7 py-3.5 text-base font-semibold text-paper transition-colors hover:bg-paper/10"
      >
        Ver transformações reais
      </a>
    </div>
  </div>
</section>
